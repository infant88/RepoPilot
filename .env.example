# -------------------------------------------------------------
# RepoPilot Environment Configuration
# -------------------------------------------------------------

# Environment & Server
ENVIRONMENT=development
PORT=8000

# Database (PostgreSQL with pgvector extension)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/repopilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=repopilot

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# LLM Provider Configuration (openai | anthropic | ollama | mock)
LLM_PROVIDER=openai
LLM_API_KEY=your-openai-or-custom-llm-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.1

# Embedding Provider Configuration (local | openai)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Cross-Encoder Reranker
RERANKER_PROVIDER=cross-encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# GitHub Integration & Webhooks
GITHUB_TOKEN=your-personal-access-token-optional-for-higher-rate-limits
GITHUB_WEBHOOK_SECRET=your-secure-webhook-secret-here

# Chunking Parameters
MAX_CHUNK_TOKENS=500
CHUNK_OVERLAP_LINES=3

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
